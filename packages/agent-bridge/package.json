{
  "name": "@ai-mcp/agent-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "Explicit, persistent agent tasks through one CLI, MCP and control API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agent-bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/node": "2.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT"
}
